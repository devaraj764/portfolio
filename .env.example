# Copy these settings into .env.local for local Next.js development.
# Add the same keys as runtime variables/secrets in Cloudflare for production.
# Use a Purelymail app password when two-factor authentication is enabled.
SMTP_HOST=smtp.purelymail.com
# Supported TLS ports: 465 (implicit TLS) or 587 (required STARTTLS).
SMTP_PORT=465
SMTP_USER=contact@devaraju.dev
SMTP_PASS=
# A plain email address authorized by your SMTP provider.
SMTP_FROM=contact@devaraju.dev
